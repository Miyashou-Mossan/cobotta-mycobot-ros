  <!-- MyCobot吸着工具：方向確認用の仮モデル -->
  <link name="mycobot_tool_link">
    <visual>
      <origin xyz="-0.018 -0.018 0.043" rpy="-1.5708 0 0" />
      <geometry>
        <mesh
          filename="package://dual_robot_description/meshes/mycobot/tool/mycobot_tips.STL"
          scale="0.001 0.001 0.001" />
      </geometry>
      <material name="mycobot_tool_black">
        <color rgba="0.15 0.15 0.15 1.0" />
      </material>
    </visual>

    <!-- MyCobot吸着部：細軸18 mm＋太い吸着面2 mm -->
    <visual>
      <origin xyz="0.000 -0.023 0.022" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.006" length="0.018" />
      </geometry>
      <material name="mycobot_suction_stem_visual">
        <color rgba="0.70 0.70 0.70 1.0" />
      </material>
    </visual>

    <visual>
      <origin xyz="0.000 -0.033 0.022" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.0085" length="0.002" />
      </geometry>
      <material name="mycobot_suction_pad_visual">
        <color rgba="0.85 0.85 0.85 1.0" />
      </material>
    </visual>

    <collision>
      <origin xyz="-0.018 -0.018 0.043" rpy="-1.5708 0 0" />
      <geometry>
        <mesh
          filename="package://dual_robot_description/meshes/mycobot/tool/mycobot_tips.STL"
          scale="0.001 0.001 0.001" />
      </geometry>
    </collision>

    <collision>
      <origin xyz="0.000 -0.023 0.022" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.006" length="0.018" />
      </geometry>
    </collision>

    <collision>
      <origin xyz="0.000 -0.033 0.022" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.0085" length="0.002" />
      </geometry>
    </collision>
  </link>

