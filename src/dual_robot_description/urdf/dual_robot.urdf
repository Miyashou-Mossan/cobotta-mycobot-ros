  <!-- COBOTTA仮TCP：未校正。修正版テスト6で実際の把持位置に合わせる -->
  <link name="cobotta_tool_link">
    <visual>
      <geometry>
        <sphere radius="0.002"/>
      </geometry>
      <material name="cobotta_tcp_marker">
        <color rgba="0 1 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="cobotta_tool_joint" type="fixed">
    <parent link="cobotta_gripper_base"/>
    <child link="cobotta_tool_link"/>
    <origin xyz="-0.002 0 0.080" rpy="0 0 0"/>
  </joint>

